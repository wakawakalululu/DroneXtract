# DroneXtract 运行配置示例
# 复制为 .env 放在程序所在目录后按需修改。
# 未提供 .env 时程序会使用内嵌默认值，功能不受影响。
#
# TELEMETRY_VIS_DOWNSAMPLE : 遥测可视化降采样点数
# FLIGHT_MAP_DOWNSAMPLE    : 飞行路径地图降采样点数
# ANALYSIS_DOWNSAMPLE      : 飞行分析降采样点数
# ANALYSIS_MAX_VARIANCE    : 27 项指标的方差阈值（空格分隔，顺序与指标一致）

TELEMETRY_VIS_DOWNSAMPLE = 40
FLIGHT_MAP_DOWNSAMPLE = 10
ANALYSIS_DOWNSAMPLE = 40
ANALYSIS_MAX_VARIANCE = "300 90 100 1000 120 100 30 30 360 40 25 1684 1684 1684 1684 1684 1684 1684 1684 360 180 180 100 20 5 500 50"
